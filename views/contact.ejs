<%- include('partials/header') %>

<main class="main-rgst d-flex align-items-center">

    <div class="container">
        <div class="my-5">

            <div class="text-center mb-5">
                <h1 class="h3 text-dark">If you have any question or suggestion, feel free to reach out</h1>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow">
                        <div class="card-body">
                            <form action="/contact" method="POST">

                                <div class="mb-4">
                                    <div class="form-group text-start text-muted">
                                        <label for="topic" class="form-label fw-semibold">Topic</label>
                                        <input type="text" id="topic" class="form-control text-start" name="topic">
                                    </div>

                                    <div class="form-group text-start text-muted">
                                        <label for="Content" class="form-label fw-semibold mt-2">Content</label>
                                        <textarea
                                            class="form-control text-start"
                                            id="Content"
                                            name="Content"
                                            rows="8"
                                            placeholder="Enter your idea here..."></textarea>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <button type="submit" class="btn btn-primary px-4">Submit</button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</main>

<%- include('partials/footer') %>