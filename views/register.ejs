<%- include('partials/header') %>

<main class="main-rgst d-flex align-items-center">

    <div class="container">
        <div class="row justify-content-md-center my-5">

            <div class="col col-lg-7 mr-5">
                <div class="text-start mb-4">
                    <h1 class="fw-bold text-dark">Register Below</h1>
                </div>

                <p class="text-secondary text-start mb-4">Simply create an account with your email.<br>
                    Password must be at least 6 characters, inluding lowercase, uppercase letters, digits and symbols.
                </p>

                <form action="/register" method="POST">
                    <div class="form-group text-start text-muted">
                        <label for="username">Name (optional)</label>
                        <input type="text" id="username" class="form-control text-start" name="username">
                    </div>
                    <div class="form-group text-start text-muted">
                        <label for="useremail">Email</label>
                        <input type="email" id="useremail" class="form-control text-start" name="useremail">
                    </div>
                    <div class="form-group text-start text-muted">
                        <label for="password">Password</label>
                        <input type="password" id="password" class="form-control text-start" name="password">
                    </div>
                    <div class="d-grid d-md-block mt-4 mb-3">
                        <button type="submit" class="btn btn-dark d-flex justify-content-center py-2">Register</button>
                    </div>
                    
                </form>

            <% if (accountCheck) { %>
                <div class="mt-3">
                    <p class="text-start" style="color: #dc3545;"><%= accountCheck %></p>
                </div>
            <% } %>                    
            </div>

            <div class="col-md-auto d-flex align-items-center justify-content-center px-4">
                <p class="text-secondary">OR</p>
            </div>

            <!-- Google Sign-Up Button -->
            <div class="col-12 col-md-auto d-flex align-items-center justify-content-center mb-3">
                <a href="/auth/google" role="button" class="btn btn-outline-dark py-2 d-block d-md-inline-block w-100">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="20rem" style="vertical-align:middle; margin-right:8px;">
                    Sign Up with Google
                </a>
            </div>
            
        </div>
    </div>

</main>

<%- include('partials/footer') %>