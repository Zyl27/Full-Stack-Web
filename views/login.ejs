<%- include('partials/header') %>

<main class="main-rgst d-flex align-items-center">

    <div class="container">
        <div class="row justify-content-md-center my-5">
            
            <div class="col col-lg-5 mr-5">
                <div class="text-start mb-4 text-dark">
                <% if (registered) { %>
                    <p class="h2"><%- registered %></p>
                <% } else { %>
                    <h1 class="fw-bold">Please sign in</h1>
                <% } %>
                </div>

                <form action="/login" method="POST">
                    <div class="text-start">
                        <label for="floatingInput" class="form-label text-dark fst-normal">Email address</label>
                        <input type="email" class="form-control" id="floatingInput" placeholder="For testing purpose, please use test1@test.com" name="useremail">
                    </div>
                    <div class="text-start mt-2">
                        <label for="floatingPassword" class="form-label text-dark fst-normal">Password</label>
                        <input type="password" class="form-control" id="floatingPassword" placeholder="For testing purpose, please use 123456" name="password">
                    </div>
                    <div>
                        <button class="btn btn-primary w-100 py-2 mb-3 mt-4" type="submit">Sign in</button>
                        <% if (loginCheck) { %>
                            <p class="text-start" style="color: #dc3545;"><%= loginCheck %></p>
                        <% } %> 
                    </div>
                </form>
            </div>

            <div class="col-md-auto d-flex align-items-center justify-content-center px-4">
                <p class="text-secondary">OR</p>
            </div>

            <!-- Google Sign-In Button -->
            <div class="col-12 col-md-auto d-flex align-items-center justify-content-center mb-3">
                <a href="/auth/google" role="button" class="btn btn-outline-primary py-2 d-block d-md-inline-block w-100">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="20rem" style="vertical-align: middle; margin-right:8px;">
                    Sign In with Google
                </a>
            </div>
            
        </div>
    </div>

</main>

<%- include('partials/footer') %>